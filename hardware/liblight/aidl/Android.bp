cc_binary {
    name: "android.hardware.light-service.msm8952",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.light-service.msm8952.rc"],
    vintf_fragments: ["android.hardware.light-service.msm8952.xml"],
    srcs: [
        "Lights.cpp",
        "main.cpp",
    ],
    shared_libs: [
        "android.hardware.light-V1-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
